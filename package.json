{
  "name": "jgcardapio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-css-module-types.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/generate-css-module-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:fsd": "steiger ./src --fail-on-warnings",
    "check:fast": "npm run lint:css && npm run typecheck && npm run check:fsd",
    "check": "npm run lint:css && npm run typecheck && npm run check:fsd && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "steiger": "^0.7.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "supabase": "^2.118.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
