WAHA_API_KEY=

# Interface onde a porta 3000 fica publicada. O padrão 127.0.0.1 deixa o
# gateway acessível só pelo proxy reverso da própria máquina. No ambiente
# local, o runtime de funções roda em outro container e alcança o gateway
# por host.docker.internal, que não chega ao loopback do host: use 0.0.0.0.
WAHA_BIND_ADDRESS=
